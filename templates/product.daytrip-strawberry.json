            "title": "Strawberry Cola",
            "title_image": "daytrip-strawberry-recipe1.png",
            "ingredients": "<p>2 oz Daytrip Strawberry Amaro<br>2–3 oz cola<br>Lemon peel</p>",
            "method": "<p>Build over ice, top with cola, express lemon peel.</p>"
          }
        },
        "recipe_2": {
          "type": "recipe",
          "settings": {
            "title": "Daytripper",
            "title_image": "daytrip-strawberry-recipe2.png",
            "ingredients": "<p>1.5 oz Daytrip Strawberry Amaro<br>0.25 oz Espadín mezcal<br>0.75 oz fresh grapefruit juice<br>0.25 oz simple syrup</p>",
            "method": "<p>Shake, strain over rocks and express grapefruit.</p>"
          }
        },
        "recipe_3": {
          "type": "recipe",
          "settings": {
            "title": "Strawberry Soda",
            "title_image": "daytrip-strawberry-recipe3.png",
            "ingredients": "<p>2 parts Daytrip Strawberry<br>2 parts soda water</p>",
            "method": "<p>Pour over ice, mix, garnish and enjoy. Top with heavy cream for an Italian soda or Prosecco for a spritz.</p>"
          }
        }
