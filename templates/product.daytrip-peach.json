          "type": "recipe",
          "settings": {
            "title": "Peach Sherry Cobbler",
            "title_image": "daytrip-peach-recipe1.png",
            "ingredients": "<p>2 oz Peach Daytrip<br>1.5 oz Amontillado sherry<br>Muddled orange</p>",
            "method": "<p>Add 2 slices of orange to a shaker tin and muddle. Add Daytrip and sherry with ice. Shake to combine. Pour over a glass with ice. Garnish with lots of fresh fruit.</p>"
          }
        },
        "recipe_2": {
          "type": "recipe",
          "settings": {
            "title": "Peach Arnold Palmer",
            "title_image": "daytrip-peach-recipe2.png",
            "ingredients": "<p>2 oz Peach Daytrip<br>Simply Lemonade<br>Unsweetened tea</p>",
            "method": "<p>Build in a Collins glass with ice. Stir to combine.</p>"
          }
        },
        "recipe_3": {
          "type": "recipe",
          "settings": {
            "title": "Peach Julep",
            "title_image": "daytrip-peach-recipe3.png",
            "ingredients": "<p>1.5 oz Peach Daytrip<br>0.75 oz bourbon<br>Mint</p>",
            "method": "<p>Add ingredients to a glass and muddle mint. Top with plenty of crushed ice. Garnish with mint and sliced peach.</p>"
          }
        }
      },
